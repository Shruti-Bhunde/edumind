# EduMind AI - Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit the real .env file or real API keys to version control.

# Google Gemini API key for explanation refinement and AI Tutor assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Google GenAI model (e.g. gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# SQLite database file path (default: data/edumind.db)
EDUMIND_DB=data/edumind.db

# Rate limit for /api endpoints (requests per minute per IP, 0 to disable)
EDUMIND_RATE_LIMIT=300

# Path to trained machine learning model classifier
EDUMIND_MODEL=models/misconception_clf.joblib
